---
import path from "node:path";
import "../styles/main.css";
import site from "../../data/site.json";
import Header from "../components/navigation/header.astro";
import Footer from "../components/navigation/footer.astro";
import { SEO } from "astro-seo";
import { GA_MEASUREMENT_ID } from "astro:env/server";

export interface SEOProps {
  page_description: string | null;
  featured_image: string | null;
  featured_image_alt: string | null;
  canonical_url: string | null;
  no_index: boolean | null;
  open_graph_type: string | null;
  author_twitter_handle: string | null;
}

export interface Props {
  title: string;
  seo?: SEOProps;
}

const { seo, title } = Astro.props;
const baseUrl = Astro.site?.toString() ?? "";

let pageTitle = "";
if (!title) {
  pageTitle = site.site_title;
} else if (Astro.url.pathname === "/") {
  pageTitle = title;
} else {
  pageTitle = `${title} | ${site.site_title}`;
}

const description = seo?.page_description ?? site.description;
const image = seo?.featured_image ?? site.image;
const imagePath = path.join(baseUrl, image);
const imageAlt = seo?.featured_image_alt ?? site.image_alt;
const canonicalURL = new URL(seo?.canonical_url ?? Astro.url.pathname, baseUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      noindex={seo?.no_index || false}
      title={pageTitle}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: pageTitle,
          url: baseUrl?.toString(),
          type: seo?.open_graph_type || "website",
          image: imagePath,
        },
        optional: { description },
        image: { url: imagePath, alt: imageAlt },
      }}
      twitter={{
        creator: `${seo?.author_twitter_handle || site.twitter_site}`,
        site: `${site.twitter_site}`,
        card: "summary_large_image",
      }}
    />
    {GA_MEASUREMENT_ID && (
      <script is:inline define:vars={{ measurementId: GA_MEASUREMENT_ID }}>
        // The Visual Editor loads production pages too; editor previews would count as visits.
        if (!window.inEditorMode) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag("js", new Date());
          window.gtag("config", measurementId);
          const tag = document.createElement("script");
          tag.async = true;
          tag.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
          document.head.append(tag);
        }
      </script>
    )}
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      if (window.inEditorMode) {
        import("../scripts/register-components.ts").catch((error) => {
          console.warn("Failed to load CloudCannon component registration:", error);
        });
        import("../scripts/analytics-panel.ts").catch((error) => {
          console.warn("Failed to load the analytics panel:", error);
        });
      }
    </script>
  </body>
</html>
